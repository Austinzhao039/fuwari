	}
	#hybrid-comment .hc-notice {
		margin-bottom: 0.75rem;
		font-size: 0.85rem;
		color: rgba(0, 0, 0, 0.4);
	}
	:global(html.dark) #hybrid-comment .hc-notice {
		color: rgba(255, 255, 255, 0.4);
	}
	#hybrid-comment .hc-loading {
		padding: 8px 0;
		font-size: 14px;
		color: #999;
	}
	#hybrid-comment .hc-lock {
		border: 1px dashed rgba(217, 70, 166, 0.4);
		border-radius: 0.75rem;
		padding: 1rem;
		text-align: center;
		margin-bottom: 1rem;
	}
	#hybrid-comment .hc-lock__title {
		font-weight: 600;
		margin: 0 0 0.35rem;
	}
	#hybrid-comment .hc-lock__desc {
		font-size: 0.8rem;
		line-height: 1.7;
		margin: 0 0 0.75rem;
		color: rgba(0, 0, 0, 0.5);
	}
	:global(html.dark) #hybrid-comment .hc-lock__desc {
