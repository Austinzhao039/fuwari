---
/**
 * twikoo-giscus：GitHub 登录（giscus 提供身份）+ 评论写进自建 Twikoo
 *
 * 为什么拆成两半：
 *   - giscus 的评论在一个 giscus.app 域的 <iframe> 里，站外页面改不了它的 DOM，
 *     所以 IP 属地、浏览器信息、同意书、管理员徽章这些需求它一个都做不到。
 *   - 但它是现成的 GitHub OAuth App，登录成功后会把登录者身份（viewer）postMessage
 *     给父页面 —— 这正好是 Twikoo 唯一缺的东西。
 *   - Twikoo 自建后端本身就返回 ipRegion（归属地）/ os / browser，还有审核与违禁词，
 *     评论区由它渲染，上面那些需求就全都还在。
 *   合起来 = 必须 GitHub 登录 + 数据在自己服务器，服务端不用再部署 Artalk。
 *
 * 注意：giscus 只在 discussion 已存在时才抛 viewer（见 giscus 源码
 * components/Giscus.tsx：`if (!emitMetadata || !data.discussion.id) return`），
 * 所以登录用的 iframe 固定指向一个专门的帖子（config 里的 giscus.loginTerm）。
 */
import type { CollectionEntry } from "astro:content";
import { commentConfig } from "@/config";
import { existsSync, readFileSync } from "node:fs";

interface Props {
	post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const twikoo = commentConfig.twikoo;
const giscus = commentConfig.giscus;
const moderation = commentConfig.moderation;
const consent = commentConfig.consent;

const envId = twikoo?.envId ?? "";
const lang = twikoo?.lang ?? "zh-CN";
const version = twikoo?.version ?? "1.6.44";
// 用固定路径作为评论标识，避免标题/文件名变更导致历史评论找不到
const path = `/posts/${post.slug}`;

const repo = giscus?.repo ?? "";
const repoId = giscus?.repoId ?? "";
const category = giscus?.category ?? "";
const categoryId = giscus?.categoryId ?? "";
const loginTerm = giscus?.loginTerm ?? "giscus-login";
const gLang = giscus?.lang ?? "zh-CN";
const badge = giscus?.badgeText ?? "管理员";

// 管理员名单：构建时从 Twikoo 后台同步下来的快照（scripts/build-giscus-theme.mjs 生成）
let admins: { login: string; name?: string }[] = [];
try {
	const metaPath = new URL("../../public/giscus/meta.json", import.meta.url);
	if (existsSync(metaPath)) {
		const meta = JSON.parse(readFileSync(metaPath, "utf8"));
		admins = Array.isArray(meta?.admins) ? meta.admins : [];
	}
} catch {
	// 没同步过就只是没有徽章，不影响评论
}

const newDiscussionUrl =
	`https://github.com/${repo}/discussions/new?category=${encodeURIComponent(category)}&title=${encodeURIComponent(loginTerm)}`;
---

<section
	class="card-base p-6 mb-4"
	id="hybrid-comment"
	data-env-id={envId}
	data-path={path}
	data-lang={lang}
	data-version={version}
	data-repo={repo}
	data-repo-id={repoId}
	data-category={category}
	data-category-id={categoryId}
	data-term={loginTerm}
	data-g-lang={gLang}
	data-badge={badge}
	data-admins={JSON.stringify(admins)}
	data-consent-version={consent?.version ?? ""}
	data-consent-title={consent?.title ?? "评论前请阅读"}
	data-consent-agree={consent?.agree ?? "我已阅读并同意"}
	data-consent-items={JSON.stringify(consent?.items ?? [])}
	data-new-discussion={newDiscussionUrl}
	data-gh-ok={repo && repoId && categoryId ? "1" : ""}
>
	<!-- GitHub 登录条 -->
	<div class="hc-bar">
		<div class="hc-bar__anon" id="hc-anon">
			<span class="hc-bar__lead">发表评论需要先登录 GitHub 账号</span>
			<button type="button" class="hc-btn hc-btn--primary" id="hc-login-btn">使用 GitHub 登录</button>
		</div>
		<div class="hc-bar__user" id="hc-user" hidden>
			<img class="hc-bar__avatar" id="hc-avatar" alt="" width="28" height="28" />
			<span class="hc-bar__name" id="hc-name"></span>
			<span class="hc-bar__tag">已登录</span>
			<button type="button" class="hc-btn hc-btn--ghost" id="hc-switch-btn">切换账号</button>
			<button type="button" class="hc-btn hc-btn--ghost" id="hc-logout-btn">退出</button>
		</div>
	</div>

	{
		moderation?.reviewRequired && (
			<p class="hc-notice">{moderation.notice ?? "评论提交后需经审核，通过后才会显示。"}</p>
		)
	}

	<div id="hc-lock" class="hc-lock" hidden>
		<p class="hc-lock__title">登录后即可评论</p>
		<p class="hc-lock__desc">
			评论会以你的 GitHub 昵称公开发布，并记录 IP 归属地与浏览器信息（用于展示来源、拦截垃圾评论）。
		</p>
		<button type="button" class="hc-btn hc-btn--primary" id="hc-lock-btn">使用 GitHub 登录</button>
	</div>

	<div id="tcomment">
		<div class="hc-loading">评论加载中…</div>
	</div>
</section>

<!-- GitHub 登录弹层 -->
<div class="hc-modal" id="hc-gh-modal" hidden>
	<div class="hc-modal__box">
		<div class="hc-modal__head">
			<h3 class="hc-modal__title">使用 GitHub 登录</h3>
			<button type="button" class="hc-modal__x" id="hc-gh-close" aria-label="关闭">×</button>
		</div>
		<p class="hc-modal__desc">
			在下面这块区域里点 <strong>Sign in with GitHub</strong>，授权完成后这个窗口会自动关闭。
		</p>
		<div class="hc-modal__frame" id="hc-giscus-host"></div>
		<p class="hc-modal__hint" id="hc-gh-hint" hidden></p>
	</div>
</div>

<!-- 用户须知 -->
<div class="hc-modal" id="hc-consent-modal" hidden>
	<div class="hc-modal__box">
		<div class="hc-modal__head">
			<h3 class="hc-modal__title" id="hc-consent-title"></h3>
		</div>
		<ul class="hc-modal__list" id="hc-consent-list"></ul>
		<div class="hc-modal__actions">
			<button type="button" class="hc-btn hc-btn--ghost" id="hc-consent-no">取消</button>
			<button type="button" class="hc-btn hc-btn--primary" id="hc-consent-yes"></button>
		</div>
	</div>
</div>

<style is:global>
	/* 全部选择器都以 #hybrid-comment / .hc- 开头，不会污染站点其它页面 */
	#hybrid-comment .hc-bar {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
	}
	#hybrid-comment .hc-bar__anon,
	#hybrid-comment .hc-bar__user {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	#hybrid-comment .hc-bar__lead,
	#hybrid-comment .hc-bar__name {
		font-size: 0.9rem;
		color: var(--primary, #d946a6);
	}
	#hybrid-comment .hc-bar__name {
		font-weight: 600;
	}
	#hybrid-comment .hc-bar__avatar {
		width: 28px;
		height: 28px;
		border-radius: 999px;
		flex: none;
	}
	#hybrid-comment .hc-bar__tag {
