		background: rgba(0, 0, 0, 0.45);
	}
	.hc-modal[hidden] {
		display: none;
	}
	.hc-modal__box {
		width: min(520px, 100%);
		max-height: 88vh;
		overflow: auto;
		background: #fff;
		border-radius: 1rem;
		padding: 1.25rem;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
	}
	:global(html.dark) .hc-modal__box {
		background: #1c1c1f;
		color: #e8e8e8;
	}
	.hc-modal__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.hc-modal__title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 700;
	}
	.hc-modal__x {
		border: 0;
