</style>

<script>
	type TwikooGlobal = { init: (options: Record<string, unknown>) => Promise<void> | void };

	const ID_KEY = "gh_identity_v1";
	const CONSENT_KEY = "comment_consent_v1";
	const META_KEY = "twikoo";

	// 主 CDN 挂了就换下一个，避免整块评论区空白
	const CDN_TEMPLATES = [
		(v: string) => `https://cdn.staticfile.org/twikoo/${v}/twikoo.all.min.js`,
		(v: string) => `https://cdn.jsdelivr.net/npm/twikoo@${v}/dist/twikoo.all.min.js`,
		(v: string) => `https://unpkg.com/twikoo@${v}/dist/twikoo.all.min.js`,
	];

	type Identity = { login: string; avatarUrl: string; url: string } | null;

	function boot(wrap: HTMLElement) {
		const anon = wrap.querySelector<HTMLElement>("#hc-anon");
		const userBox = wrap.querySelector<HTMLElement>("#hc-user");
		const avatarEl = wrap.querySelector<HTMLImageElement>("#hc-avatar");
		const nameEl = wrap.querySelector<HTMLElement>("#hc-name");
		const lockBox = wrap.querySelector<HTMLElement>("#hc-lock");
		const ghModal = document.getElementById("hc-gh-modal");
		const ghHost = document.getElementById("hc-giscus-host");
		const ghHint = document.getElementById("hc-gh-hint");
		const consentModal = document.getElementById("hc-consent-modal");

		let admins: { login: string; name?: string }[] = [];
		try {
			admins = JSON.parse(wrap.dataset.admins || "[]");
		} catch {
			admins = [];
		}
		const adminSet = new Set(admins.map((a) => String(a.login || "").toLowerCase()).filter(Boolean));
		const badgeText = wrap.dataset.badge || "管理员";

		let identity: Identity = null;
		try {
			identity = JSON.parse(localStorage.getItem(ID_KEY) || "null");
		} catch {
			identity = null;
		}

		// ---------- 身份 ----------
		function mailOf(login: string) {
			return `${login}@users.noreply.github.com`;
		}

		// Twikoo 会把 localStorage["twikoo"] 里的 nick/mail/avatar 读进表单并随评论提交
		function writeTwikooMeta() {
			if (!identity) return;
			try {
				localStorage.setItem(
					META_KEY,
					JSON.stringify({
						nick: identity.login,
						mail: mailOf(identity.login),
						avatar: identity.avatarUrl || "",
						link: identity.url || `https://github.com/${identity.login}`,
					}),
				);
			} catch {
				/* 隐私模式下写不了就算了 */
			}
		}

		function renderBar() {
			if (!anon || !userBox || !lockBox || !nameEl) return;
			if (identity) {
				anon.hidden = true;
				userBox.hidden = false;
				lockBox.hidden = true;
				nameEl.textContent = identity.login;
				if (avatarEl) {
					avatarEl.src = identity.avatarUrl || "";
					avatarEl.alt = identity.login;
				}
				wrap.classList.remove("hc-locked");
			} else {
				anon.hidden = false;
				userBox.hidden = true;
				lockBox.hidden = false;
				wrap.classList.add("hc-locked");
			}
		}

		function setIdentity(next: Identity) {
			identity = next;
			if (next) localStorage.setItem(ID_KEY, JSON.stringify(next));
			else localStorage.removeItem(ID_KEY);
			writeTwikooMeta();
			renderBar();
			syncEditor();
		}

		// Twikoo 官方前端会在 init 时把 #tcomment 整个替换掉（新节点不再带这个 id），
		// 所以一切都从不会被替换的 wrap 上找，否则观察器会挂在一个已移除的节点上。
		const scopeRoot = () => wrap;

		// ---------- Twikoo 表单同步 ----------
		function syncEditor() {
			const root = scopeRoot();
			if (!root) return;
			// 登录后把昵称/邮箱/网址填成 GitHub 身份并锁住，避免访客乱填冒充
			if (identity) {
				const inputs = root.querySelectorAll<HTMLInputElement>(".tk-meta-input input");
				inputs.forEach((inp) => {
					const key = (inp.getAttribute("name") || inp.getAttribute("placeholder") || "").toLowerCase();
					let value: string | null = null;
					if (key.includes("nick") || key.includes("昵称")) value = identity!.login;
					else if (key.includes("mail") || key.includes("邮箱")) value = mailOf(identity!.login);
					else if (key.includes("link") || key.includes("网址")) value = identity!.url || `https://github.com/${identity!.login}`;
					if (value != null && inp.value !== value) {
						inp.value = value;
						inp.dispatchEvent(new Event("input", { bubbles: true }));
					}
					inp.readOnly = true;
				});
			}
			syncAvatars();
			injectBadges();
		}

		/**
		 * 头像一律用 GitHub 的。
		 * 坑一：Twikoo 的 COMMENT_SUBMIT 会把前端传过去的 avatar 字段丢掉（实测过：提交后
		 * 数据库里根本没有 avatar 这一项），公开列表拿不到头像就退回 gravatar 占位图。
		 * 坑二：avatars.githubusercontent.com/<用户名> 不认用户名，只会返回默认像素图，
		 * 必须用 github.com/<用户名>.png —— 它会 302 到带数字 ID 的真头像，
		 * 不存在的用户返回 404，正好走 onerror 回退成原来的 gravatar。
		 */
		const ghAvatar = (login: string) => `https://github.com/${encodeURIComponent(login)}.png?size=80`;

		function swapAvatar(img: HTMLImageElement, url: string) {
			if (!url) return;
			// 两个条件都满足才跳过：Vue 有可能把 src 改回去，只认 dataset 会漏
			if (img.dataset.hcAvatar === url && img.getAttribute("src") === url) return;
			img.dataset.hcAvatar = url;
			const fallback = img.getAttribute("src") || "";
			img.onerror = () => {
				img.onerror = null;
				if (fallback && fallback !== url) img.src = fallback;
			};
			img.src = url;
		}

		function syncAvatars() {
			const root = scopeRoot();
			if (!root) return;
			// 自己：用 giscus 给的精确头像地址（带数字 ID，最准）
			if (identity?.avatarUrl) {
				root
					.querySelectorAll<HTMLImageElement>(".tk-submit img.tk-avatar-img")
					.forEach((img) => swapAvatar(img, identity!.avatarUrl));
			}
			// 别人：现在必须登录 GitHub 才能评论，所以昵称就是 GitHub 用户名
			root.querySelectorAll<HTMLElement>(".tk-comment").forEach((el) => {
				const nickEl = el.querySelector<HTMLElement>(".tk-nick, .tk-nick-link");
				const nick = (nickEl?.textContent || "").trim();
				if (!/^[A-Za-z0-9-]{1,39}$/.test(nick)) return;
				const img = el.querySelector<HTMLImageElement>("img.tk-avatar-img");
				if (img) swapAvatar(img, ghAvatar(nick));
			});
		}

		function injectBadges() {
			const root = scopeRoot();
			if (!root || !adminSet.size) return;
			root.querySelectorAll<HTMLElement>(".tk-comment").forEach((el) => {
				if (el.dataset.hcBadge) return;
				el.dataset.hcBadge = "1";
				// Twikoo 自己会给 master 评论加 .tk-tag，别重复挂
				if (el.querySelector(".tk-tag")) return;
				const nickEl = el.querySelector<HTMLElement>(".tk-nick, .tk-nick-link");
				const nick = (nickEl?.textContent || "").trim().toLowerCase();
				if (!nick || !adminSet.has(nick)) return;
				const span = document.createElement("span");
				span.className = "hc-badge";
				span.textContent = badgeText;
				(nickEl?.parentNode || el).appendChild(span);
			});
		}

		// Vue 会反复重绘评论区，观察器必须挂在不会被替换的 wrap 上
		let timer: number | undefined;
		const schedule = () => {
			if (timer) window.clearTimeout(timer);
			timer = window.setTimeout(syncEditor, 120);
		};
		// 连 src 属性一起听：Vue 有时只改属性不加节点，头像会被改回 gravatar
		new MutationObserver(schedule).observe(wrap, {
			childList: true,
			subtree: true,
			attributes: true,
			attributeFilter: ["src"],
		});

		// ---------- 用户须知 ----------
		const consentVersion = wrap.dataset.consentVersion || "";
		const agreed = () => !consentVersion || localStorage.getItem(CONSENT_KEY) === consentVersion;
		let pendingSend: HTMLElement | null = null;

		function showConsent(btn: HTMLElement) {
			pendingSend = btn;
			if (!consentModal) return;
			const titleEl = document.getElementById("hc-consent-title");
			const listEl = document.getElementById("hc-consent-list");
			const yesEl = document.getElementById("hc-consent-yes");
			if (titleEl) titleEl.textContent = wrap.dataset.consentTitle || "评论前请阅读";
			if (yesEl) yesEl.textContent = wrap.dataset.consentAgree || "我已阅读并同意";
			if (listEl) {
				let items: string[] = [];
				try {
					items = JSON.parse(wrap.dataset.consentItems || "[]");
				} catch {
					items = [];
				}
				listEl.replaceChildren(
					...items.map((t) => {
						const li = document.createElement("li");
						li.textContent = t;
						return li;
					}),
				);
			}
			consentModal.hidden = false;
		}

		document.getElementById("hc-consent-no")?.addEventListener("click", () => {
			if (consentModal) consentModal.hidden = true;
			pendingSend = null;
		});
		document.getElementById("hc-consent-yes")?.addEventListener("click", () => {
			localStorage.setItem(CONSENT_KEY, consentVersion);
			if (consentModal) consentModal.hidden = true;
			const btn = pendingSend;
			pendingSend = null;
			if (btn) window.setTimeout(() => btn.click(), 50);
		});

		// 发送前拦一次（捕获阶段，抢在 Vue 的 handler 之前；挂在 wrap 上才不会因为节点被替换而失效）
		wrap.addEventListener(
			"click",
			(e) => {
				const target = e.target as HTMLElement | null;
				const btn = target?.closest?.(".tk-send") as HTMLElement | null;
				if (!btn) return;
				if (agreed()) return;
				e.preventDefault();
				e.stopPropagation();
				showConsent(btn);
			},
			true,
		);

		// ---------- giscus 登录 ----------
		let giscusLoaded = false;
		function loadGiscus() {
			if (giscusLoaded || !ghHost) return;
			giscusLoaded = true;
			const s = document.createElement("script");
			s.src = "https://giscus.app/client.js";
			const attrs: Record<string, string> = {
				"data-repo": wrap.dataset.repo || "",
				"data-repo-id": wrap.dataset.repoId || "",
				"data-category": wrap.dataset.category || "",
				"data-category-id": wrap.dataset.categoryId || "",
				// 固定指向专门用来登录的帖子，保证任何页面都能拿到登录者身份
				"data-mapping": "specific",
				"data-term": wrap.dataset.term || "giscus-login",
				"data-strict": "1",
				"data-reactions-enabled": "0",
				"data-emit-metadata": "1",
				"data-input-position": "top",
				"data-theme": document.documentElement.classList.contains("dark") ? "dark" : "light",
				"data-lang": wrap.dataset.gLang || "zh-CN",
				"data-loading": "lazy",
			};
			for (const [k, v] of Object.entries(attrs)) s.setAttribute(k, v);
			s.crossOrigin = "anonymous";
			s.async = true;
			ghHost.appendChild(s);

			// 迟迟收不到身份多半是那个登录帖还没建，给个能直接点的链接
			window.setTimeout(() => {
				if (identity || !ghHint) return;
				const url = wrap.dataset.newDiscussion || "";
				ghHint.hidden = false;
				ghHint.textContent = url
					? `没看到登录入口？多半是仓库里还没有标题为「${wrap.dataset.term}」的帖子，点这里创建后重试：${url}`
					: "没看到登录入口？请检查 giscus 仓库配置。";
			}, 9000);
		}

		function openGhModal() {
			if (!ghModal) return;
			ghModal.hidden = false;
			loadGiscus();
		}
		function closeGhModal() {
			if (ghModal) ghModal.hidden = true;
		}

		document.getElementById("hc-login-btn")?.addEventListener("click", openGhModal);
		document.getElementById("hc-lock-btn")?.addEventListener("click", openGhModal);
		document.getElementById("hc-switch-btn")?.addEventListener("click", openGhModal);
		document.getElementById("hc-gh-close")?.addEventListener("click", closeGhModal);
		ghModal?.addEventListener("click", (e) => {
			if (e.target === ghModal) closeGhModal();
		});
		document.getElementById("hc-logout-btn")?.addEventListener("click", () => {
			setIdentity(null);
			if (ghHost) ghHost.replaceChildren();
			giscusLoaded = false;
		});

		window.addEventListener("message", (event) => {
			if (event.origin !== "https://giscus.app") return;
			const data = (event.data && event.data.giscus) as
				| { viewer?: { login?: string; avatarUrl?: string; url?: string }; signOut?: boolean; error?: string }
				| undefined;
			if (!data) return;
			if (data.signOut) {
				setIdentity(null);
				return;
			}
			if (data.viewer && data.viewer.login) {
				setIdentity({
					login: data.viewer.login,
					avatarUrl: data.viewer.avatarUrl || "",
					url: data.viewer.url || `https://github.com/${data.viewer.login}`,
				});
				closeGhModal();
			}
		});

		// ---------- Twikoo ----------
		let reported = false;
		function renderMessage(text: string) {
			// Twikoo 可能已经把 #tcomment 换掉了，所以统一往 wrap 末尾追加提示
			if (reported) return;
			reported = true;
			const box = document.createElement("div");
			box.style.cssText = "padding:8px 0;color:#888;font-size:14px;line-height:1.8;";
			box.textContent = text;
			wrap.appendChild(box);
		}

		let started = false;
		const version = wrap.dataset.version || "1.6.44";

		function mount(): boolean {
			const tk = (window as unknown as { twikoo?: TwikooGlobal }).twikoo;
			if (!tk) return false;
			const id = wrap.dataset.envId || "";
			if (!/^https?:\/\//i.test(id)) {
				renderMessage(`评论后端地址无效：「${id || "(空)"}」。请把 src/config.ts 里 twikoo.envId 设成完整的 http(s) 地址。`);
				return true;
			}
			try {
				const ret = tk.init({
					envId: id,
					el: "#tcomment",
					path: wrap.dataset.path || location.pathname,
					lang: wrap.dataset.lang || "zh-CN",
				});
				if (ret && typeof (ret as Promise<void>).catch === "function") {
					(ret as Promise<void>).catch((e) => {
						console.error("[twikoo] 评论加载失败", e);
						renderMessage(`评论加载失败：${e instanceof Error ? e.message : String(e)}`);
					});
				}
			} catch (e) {
				console.error("[twikoo] 评论加载失败", e);
				renderMessage(`评论加载失败：${e instanceof Error ? e.message : String(e)}`);
			}
			return true;
		}

		function loadScript(index: number) {
			if (index >= CDN_TEMPLATES.length) {
				renderMessage("评论组件（Twikoo）加载失败，请检查网络或 CDN 是否可访问。");
				return;
			}
			const script = document.createElement("script");
			script.src = CDN_TEMPLATES[index](version);
			script.async = true;
			script.onload = () => {
				if (!mount()) loadScript(index + 1);
			};
			script.onerror = () => {
				script.remove();
				loadScript(index + 1);
			};
			document.head.appendChild(script);
		}

		writeTwikooMeta();
		renderBar();
		if (!started) {
			started = true;
			if (!mount()) loadScript(0);
		}
	}

	const wrap = document.getElementById("hybrid-comment");
	if (wrap) {
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", () => boot(wrap), { once: true });
		} else {
			boot(wrap);
		}
	}
</script>
