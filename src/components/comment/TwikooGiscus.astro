		margin: 0.75rem 0 0;
		padding-left: 1.15rem;
		font-size: 0.85rem;
		line-height: 1.85;
	}
	.hc-modal__actions {
		display: flex;
		justify-content: flex-end;
		gap: 0.5rem;
		margin-top: 1rem;
	}
	.hc-btn {
		cursor: pointer;
		border-radius: 999px;
