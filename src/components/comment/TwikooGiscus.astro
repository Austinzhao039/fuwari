	}
	/* 未登录时把 Twikoo 的输入框整块藏掉，只留评论列表。
	   注意：twikoo.init 会把 #tcomment 整个替换掉，所以不能依赖 #tcomment 做祖先选择器 */
	#hybrid-comment.hc-locked .tk-submit {
