		margin-left: 6px;
		padding: 0 6px;
		height: 18px;
		line-height: 16px;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.02em;
		border-radius: 999px;
		vertical-align: middle;
		white-space: nowrap;
		background: #fdf2f8;
		border: 1px solid #f7b6d2;
		color: #be185d;
	}
	:global(html.dark) #hybrid-comment .hc-badge {
		background: #3d1528;
		border-color: #9d174d;
		color: #f9a8d4;
	}
	/* 弹层 */
	.hc-modal {
		position: fixed;
		inset: 0;
		z-index: 999;
		display: flex;
		align-items: center;
		justify-content: center;
