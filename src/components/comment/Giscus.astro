---
import { commentConfig } from "@/config";
import { existsSync, readFileSync } from "node:fs";

const giscus = commentConfig.giscus;
const ready = Boolean(giscus?.repo && giscus?.repoId && giscus?.category && giscus?.categoryId);

// 自定义主题（内置主题 + 「管理员」徽章）由 scripts/build-giscus-theme.mjs 生成，
// 版本号取自 meta.json 的内容哈希，用来绕过 CDN / 浏览器缓存。
let version = { light: "", dark: "" };
try {
	const metaPath = new URL("../../public/giscus/meta.json", import.meta.url);
	if (existsSync(metaPath)) {
		const meta = JSON.parse(readFileSync(metaPath, "utf8"));
		if (meta?.version) version = meta.version;
	}
} catch {
	// 没生成过就退回内置主题，不影响评论功能
}

const base = (giscus?.themeBase ?? "").replace(/\/+$/, "");
const themeLight = base && version.light ? `${base}/light.css?v=${version.light}` : "";
const themeDark = base && version.dark ? `${base}/dark.css?v=${version.dark}` : "";
---

<section
	class="card-base p-6 mb-4"
	id="giscus-wrap"
	data-theme-light={themeLight}
	data-theme-dark={themeDark}
	data-badge={giscus?.badgeText ?? "管理员"}
>
	{
		ready ? (
			// data-theme 先给内置 light 兜底，加载后再换成带「管理员」徽章的自定义主题；
			// 万一 CDN 拿不到，giscus 会保留内置主题，不会变成没样式的白板
			<script
				is:inline
				src="https://giscus.app/client.js"
				data-repo={giscus!.repo}
				data-repo-id={giscus!.repoId}
				data-category={giscus!.category}
				data-category-id={giscus!.categoryId}
				data-mapping={giscus!.mapping ?? "pathname"}
				data-strict={giscus!.strict ?? "0"}
				data-reactions-enabled={giscus!.reactionsEnabled ?? "1"}
				data-emit-metadata="1"
				data-input-position={giscus!.inputPosition ?? "top"}
				data-theme="light"
				data-lang={giscus!.lang ?? "zh-CN"}
				data-loading="lazy"
				crossorigin="anonymous"
				async
			/>
		) : (
			<p class="text-sm text-black/40 dark:text-white/40">
				评论功能正在配置中，暂时不可用。
			</p>
		)
	}
</section>

<!-- giscus 在 iframe 里，不继承站点主题，要手动 postMessage 通知它切换 -->
<script is:inline>
	(function () {
		var wrap = document.getElementById("giscus-wrap");
		if (!wrap) return;
		var LIGHT = wrap.getAttribute("data-theme-light") || "";
		var DARK = wrap.getAttribute("data-theme-dark") || "";
		var sentFor = "";

		function isDark() {
			return document.documentElement.classList.contains("dark");
		}

		function send(theme) {
			var frame = document.querySelector("iframe.giscus-frame");
			if (!frame || !frame.contentWindow || !theme) return;
			frame.contentWindow.postMessage(
				{ giscus: { setConfig: { theme: theme } } },
				"https://giscus.app",
			);
		}

		function custom() {
			return isDark() ? DARK : LIGHT;
		}

		// giscus 自己在 iframe 里要等 React 挂载 + 拉完 GitHub 数据才装 message 监听，
		// 太早发的消息会被直接丢掉。所以第一次发现 iframe 后按节奏补发几次：
		// 发同一个主题是幂等的（React state 不变不会重建 <link>），多发没有副作用。
		var bursting = false;
		function burst() {
			if (bursting) return;
			bursting = true;
			[300, 900, 1800, 3200, 5000, 7500, 11000, 15000, 20000, 26000, 32000].forEach(function (ms) {
				window.setTimeout(function () {
					send(custom());
				}, ms);
			});
			window.setTimeout(function () {
				bursting = false;
			}, 33000);
		}

		function apply(force) {
			var frame = document.querySelector("iframe.giscus-frame");
			if (!frame) return;
			if (!frame.__giscusThemeHooked) {
				frame.__giscusThemeHooked = true;
				frame.addEventListener("load", function () {
					send(custom());
					burst();
				});
				// 懒加载：iframe 只有滚到附近才真正去加载
				burst();
			}
			var key = (isDark() ? "d" : "l") + custom();
			if (!force && key === sentFor) return;
			sentFor = key;
			// 站点切主题时：先发内置主题（保证一定有样式），再补发带徽章的自定义主题。
			// 多次补发是因为两个 <link> 谁先 load 完不确定，谁后到谁生效，多发几次让它收敛到自定义主题。
			send(isDark() ? "dark" : "light");
			[250, 1000, 2200].forEach(function (ms) {
				window.setTimeout(function () {
					send(custom());
				}, ms);
			});
		}

		// iframe 是异步插入的，用观察器等它出现
		var pending = false;
		new MutationObserver(function () {
			if (pending) return;
			pending = true;
			requestAnimationFrame(function () {
				pending = false;
				apply(false);
			});
		}).observe(document.body, { childList: true, subtree: true });

		// giscus 渲染完 discussion 会回一条 metadata 消息（开了 data-emit-metadata），
		// 这时它的 message 监听一定已经装好，是最可靠的换主题时机
		window.addEventListener("message", function (event) {
			if (event.origin !== "https://giscus.app") return;
			var data = event.data && event.data.giscus;
			if (!data || !(data.discussion || data.error)) return;
			send(custom());
		});

		// 站点切深浅色时同步
		new MutationObserver(function () {
			apply(true);
		}).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

		window.addEventListener("load", function () {
			apply(true);
		});
		apply(false);
	})();
</script>
